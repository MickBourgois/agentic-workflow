{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "card", "reason"],
  "properties": {
    "status": { "enum": ["selected", "empty", "needs_human"] },
    "card": { "type": ["string", "null"] },
    "reason": { "type": "string" }
  }
}
